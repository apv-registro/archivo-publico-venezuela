{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apv/case.schema.json",
  "title": "APV evidence case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "event_date", "status", "documents", "claims"],
  "properties": {
    "id": {"type": "string", "pattern": "^VE-[0-9]{4}-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 5},
    "event_date": {"type": "string", "format": "date"},
    "status": {"enum": ["draft", "reviewed", "published", "disputed", "corrected"]},
    "institutions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "publisher", "source_url", "retrieved_at", "sha256"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "publisher": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "archived_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
          "language": {"type": "string"}
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text", "citations"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["documented_fact", "attributed_assessment", "project_analysis"]},
          "text": {"type": "string"},
          "persons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "citations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["document_id", "locator"],
              "properties": {
                "document_id": {"type": "string"},
                "locator": {"type": "string", "description": "Page, article, paragraph, or table"},
                "quotation": {"type": "string"}
              }
            }
          }
        }
      }
    }
  }
}
