{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/apv/person.schema.json",
  "title": "APV person",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "name_variants", "public_positions", "sources"],
  "properties": {
    "id": {"type": "string", "pattern": "^VE-P-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 3},
    "name_variants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "birth_date": {"type": "string", "format": "date"},
    "nationality": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "public_positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "institution", "sources"],
        "properties": {
          "title": {"type": "string"},
          "institution": {"type": "string"},
          "start_date": {"type": "string", "format": "date"},
          "end_date": {"type": "string", "format": "date"},
          "sources": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "publisher", "retrieved_at"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "publisher": {"type": "string"},
          "retrieved_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "identity_notes": {"type": "string"}
  }
}
