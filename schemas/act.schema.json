{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apv-registro.github.io/archivo-publico-venezuela/schemas/act.schema.json",
  "title": "APV act dossier",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "event_id", "title", "date", "issuer", "action", "status", "evidence_records", "normative_basis", "persons", "findings", "open_questions"],
  "properties": {
    "id": {"type": "string", "pattern": "^VE-[0-9]{4}-ACT-[A-Z0-9-]+$"},
    "event_id": {"type": "string"},
    "title": {"type": "string", "minLength": 8},
    "date": {"type": "string"},
    "issuer": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "action": {"type": "string", "minLength": 20},
    "status": {"enum": ["open", "partial", "reviewed", "documented", "disputed"]},
    "evidence_records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "normative_basis": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
    "persons": {"type": "array", "items": {"$ref": "#/$defs/person_link"}},
    "findings": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "preservation_status", "evidence_class"],
      "properties": {
        "id": {"type": "string"}, "title": {"type": "string"},
        "preservation_status": {"enum": ["preserved", "partial", "missing"]},
        "evidence_class": {"enum": ["A", "B", "C", "D", "E"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "file": {"type": "string"}, "source_url": {"type": "string"}, "locator": {"type": "string"}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "locator"],
      "properties": {"title": {"type": "string"}, "locator": {"type": "string"}, "record_id": {"type": "string"}}
    },
    "person_link": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "action", "attribution", "evidence"],
      "properties": {
        "id": {"type": "string"}, "action": {"type": "string"},
        "attribution": {"enum": ["direct", "collegial", "authority_supervision", "authority_and_supervision", "recipient", "subject", "claimant", "claimant_subject", "counsel", "certifying_officer", "mentioned"]},
        "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    }
  }
}
